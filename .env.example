APP_ENV=local
JAVA_PLATFORM_PORT=8080
FRONTEND_PORT=3000
POSTGRES_URL=jdbc:postgresql://localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0
NACOS_SERVER_ADDR=localhost:8848
MODEL_PROVIDER=mock
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MILLIS=1000
MODEL_AGENT_IDS=supervisor
CLIPROXY_API_BASE_URL=http://127.0.0.1:8317/v1
CLIPROXY_MODEL=gpt-5.5
CLIPROXY_TIMEOUT_SECONDS=30
# Inject CLIPROXY_API_KEY through the local shell or deployment secret store.
