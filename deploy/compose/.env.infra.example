TZ=Asia/Shanghai

EAP_IMAGE=enterprise-agent-platform
EAP_IMAGE_TAG=local
EAP_WORKER_IMAGE=enterprise-agent-worker
EAP_WORKER_IMAGE_TAG=local
EAP_MODEL_PROVIDER=mock
EAP_MODEL_AGENT_IDS=supervisor

EAP_INFRA_NETWORK_NAME=infra-stack_infra

EAP_POSTGRES_DB=agent_platform
EAP_POSTGRES_USER=agent_platform_app
EAP_POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_STRING_AT_LEAST_24_CHARS

EAP_REDIS_DB=3
EAP_REDIS_PASSWORD=REPLACE_WITH_INFRA_REDIS_PASSWORD

EAP_CLIPROXY_API_BASE_URL=http://infra-cli-proxy-api:8317/v1
EAP_CLIPROXY_API_KEY=REPLACE_WITH_CLIPROXY_API_KEY
EAP_CLIPROXY_MODEL=gpt-5.5
EAP_CLIPROXY_TIMEOUT_SECONDS=30
EAP_WORKER_BATCH_SIZE=10
EAP_WORKER_POLL_INTERVAL_MILLIS=1000
EAP_WORKER_MAX_ATTEMPTS=3
